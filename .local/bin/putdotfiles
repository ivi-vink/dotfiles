#!/bin/sh
if [ -d "$HOME/.local/src/dotfiles/.git" ]; then
	cd "$HOME/.local/src/dotfiles"
	ls -A | grep -v -e '^.git' -e '.*.img' | xargs -I xxx cp -rvf \
		"$HOME/.local/src/dotfiles/xxx" \
		 "$HOME"
        ln -sf "$HOME/.gnupg/gpg-agent.conf.$(uname -s)" "$HOME/.gnupg/gpg-agent.conf"
        brew tap-new local/local || true
        ln -sf "$HOME/.local/share/homebrew/Formula" "$(brew --repository)/Library/Taps/local/homebrew-local"
else
	putgitrepo \
		https://github.com/ivi-vink/dotfiles.git \
		"$HOME"
fi
rm -rf "$HOME/.git" || true
