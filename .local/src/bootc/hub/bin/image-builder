#!/bin/sh
#
# Run the osbuild image-builder container against local podman storage.
#
# Arguments are passed through to the image-builder CLI, e.g.
#   bin/image-builder build --bootc-ref localhost/hub:latest \
#       --arch x86_64 --output-dir /output --output-name hub qcow2
#
# Environment (defaults mirror the Makefile):
#   PODMAN             container runtime; may be "sudo podman"
#   CONTAINERS_STORAGE host podman storage, mounted read-write in the container
#   OUTPUT_DIR         host directory bind-mounted at /output
#   IMAGE_BUILDER      image-builder container image to run

set -eu

PODMAN="${PODMAN:-podman}"
CONTAINERS_STORAGE="${CONTAINERS_STORAGE:-/var/lib/containers/storage}"
OUTPUT_DIR="${OUTPUT_DIR:-output}"
IMAGE_BUILDER="${IMAGE_BUILDER:-ghcr.io/osbuild/image-builder:latest}"

# image-builder needs an absolute host path for the bind mount.
case "$OUTPUT_DIR" in
	/*) output_dir="$OUTPUT_DIR" ;;
	*)  output_dir="$PWD/$OUTPUT_DIR" ;;
esac

# PODMAN is intentionally unquoted so "sudo podman" expands to two words.
$PODMAN run --rm --privileged --pull=newer \
	--security-opt label=type:unconfined_t \
	--volume "$CONTAINERS_STORAGE":/var/lib/containers/storage \
	--volume "$output_dir":/output \
	"$IMAGE_BUILDER" \
	"$@"
