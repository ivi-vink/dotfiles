# Radicale is reached through the Traefik reverse proxy, so it only listens on
# loopback; TLS and the public hostname are handled by Traefik.
# https://radicale.org/v3.html#configuration

[server]
hosts = 127.0.0.1:5232

# Trust the Traefik reverse proxy for authentication: Traefik's basicAuth
# middleware verifies credentials and sets X-Remote-User (headerField), which
# Radicale takes as the authenticated username. Radicale's own HTTP auth is
# disabled. Only safe because Radicale listens on loopback (see above).
[auth]
type = http_x_remote_user

# The web UI probes for existing authentication (e.g. the X-Remote-User set
# by Traefik's basicAuth) with a request that includes the browser's cached
# Basic credentials. Otherwise the probe is unauthenticated, Traefik rejects
# it, and the UI always shows its (redundant) login form.
[web]
prefer_browser_login = True

[storage]
filesystem_folder = /var/lib/radicale/collections

[rights]
type = owner_only
