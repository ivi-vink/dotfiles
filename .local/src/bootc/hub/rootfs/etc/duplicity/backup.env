# Duplicity backup configuration, read by duplicity-backup.service.
# See usr/local/bin/duplicity-backup for the defaults that apply when a
# variable is unset, and compose.yaml for the RustFS test stack.
# To override on a deployment, bind-mount a replacement file over this
# path (compose.yaml has a commented-out example).

# RustFS/S3 endpoint. "rustfs" resolves on the compose network; point it
# at a real host for production.
S3_HOST=rustfs
S3_PORT=9000
S3_BUCKET=backups
S3_PREFIX=hub

# Test credentials matching RustFS's own defaults. CHANGEME for real use;
# keep in sync with RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY in compose.yaml.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# Set to a non-empty passphrase to encrypt the backup with GnuPG
# (symmetric). Empty = unencrypted; fine for the test stack.
PASSPHRASE=

# State directories to back up, space separated.
SOURCES=/var/lib/radicale

# Run a full backup when the last full chain is older than FULL_AFTER;
# prune chains older than KEEP_FOR.
FULL_AFTER=7D
KEEP_FOR=90D
